# Compiled iPXE binaries (large — fetch from boot.ipxe.org at deploy time)
*.efi

# Signing certs and keys (sensitive — never commit)
*.crt
*.pem
*.key
*.pfx
*.p12

# Windows build artifacts
*.tmp
*.log

# Local scratch + backups (underscore-prefixed convention)
_*

# Push-pipeline output log (regenerated each push)
push-out.txt
